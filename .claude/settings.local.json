{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": ["*"]
    }
  }
}
